[
  {"op": "log", "message": "real conversions, results with sizes, Save, Reveal, Open, Save all and Convert again"},
  {"op": "dialogs", "mode": "seam"},
  {"op": "open", "files": ["${IN}/hello.txt", "${IN}/fox.txt", "${IN}/data.bin", "${IN}/crlf.txt"]},
  {"op": "setTarget", "index": 0, "target": "base64"},
  {"op": "setTarget", "index": 1, "target": "hex"},
  {"op": "setTarget", "index": 2, "target": "checksums"},
  {"op": "setTarget", "index": 3, "target": "txt"},
  {"op": "setOption", "index": 3, "key": "encoding", "value": "utf-16le"},
  {"op": "setOption", "index": 3, "key": "bom", "value": true},
  {"op": "setOption", "index": 3, "key": "line_endings", "value": "lf"},
  {"op": "frames", "count": 30},
  {"op": "click", "label": "Convert all", "exact": true},
  {"op": "waitIdle"},
  {"op": "frames", "count": 40},
  {"op": "dump", "path": "r-done.json"},
  {"op": "screenshot", "path": "r-done.bmp"},
  {"op": "dialogReply", "paths": ["${OUT}/one/hello-saved.b64"]},
  {"op": "click", "label": "Save", "exact": true, "nth": 0},
  {"op": "frames", "count": 3},
  {"op": "dump", "path": "r-saved.json"},
  {"op": "click", "label": "Show in folder"},
  {"op": "click", "label": "Open with the default app", "nth": 0},
  {"op": "frames", "count": 2},
  {"op": "dump", "path": "r-shell.json"},
  {"op": "dialogReply", "paths": ["${OUT}/all"]},
  {"op": "click", "label": "Save all", "exact": true},
  {"op": "frames", "count": 3},
  {"op": "dump", "path": "r-all.json"},
  {"op": "click", "label": "Convert again with other settings", "nth": 0},
  {"op": "frames", "count": 3},
  {"op": "dump", "path": "r-again-ready.json"},
  {"op": "setOption", "index": 0, "key": "line_width", "value": 8},
  {"op": "click", "label": "Convert", "exact": true, "last": true},
  {"op": "waitIdle"},
  {"op": "frames", "count": 5},
  {"op": "dump", "path": "r-again.json"},
  {"op": "saveAll", "dir": "again", "expect": 4}
]
