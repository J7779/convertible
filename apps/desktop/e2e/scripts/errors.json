[
  {"op": "log", "message": "a failing conversion explains itself and leaves the queue intact"},
  {"op": "dialogs", "mode": "seam"},
  {"op": "open", "files": ["${IN}/bad.b64", "${IN}/good.txt"]},
  {"op": "setTarget", "index": 0, "target": "${DECODE_TARGET}"},
  {"op": "setTarget", "index": 1, "target": "base64"},
  {"op": "frames", "count": 30},
  {"op": "click", "label": "Convert all", "exact": true},
  {"op": "waitIdle"},
  {"op": "frames", "count": 30},
  {"op": "dump", "path": "e-failed.json"},
  {"op": "screenshot", "path": "e-failed.bmp"},
  {"op": "click", "label": "Try again", "exact": true},
  {"op": "frames", "count": 5},
  {"op": "dump", "path": "e-retry.json"},
  {"op": "dialogReply", "paths": ["${OUT}/missing-folder/x.b64"]},
  {"op": "click", "label": "Save", "exact": true},
  {"op": "frames", "count": 3},
  {"op": "dump", "path": "e-savefail.json"},
  {"op": "shellResult", "value": false},
  {"op": "click", "label": "Open with the default app"},
  {"op": "frames", "count": 3},
  {"op": "dump", "path": "e-shell.json"},
  {"op": "screenshot", "path": "e-shell.bmp"}
]
