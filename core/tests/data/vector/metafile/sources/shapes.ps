%!PS-Adobe-3.0
%%BoundingBox: 0 0 200 150
%%EndComments
% A blue filled square, a red stroked circle, a green triangle and a line of text.
0 0 1 setrgbcolor
20 20 60 60 rectfill
1 0 0 setrgbcolor
4 setlinewidth
140 50 30 0 360 arc closepath stroke
0 0.5 0 setrgbcolor
20 100 moveto 80 100 lineto 50 140 lineto closepath fill
0 0 0 setrgbcolor
2 setlinewidth
[6 3] 0 setdash
100 120 moveto 190 140 lineto stroke
showpage
%%EOF
