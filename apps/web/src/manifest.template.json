{
  "id": "./",
  "name": "Convertible",
  "short_name": "Convertible",
  "description": "Convert files privately and offline. Nothing is uploaded: every conversion runs on your device.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0D0F16",
  "theme_color": "#0D0F16",
  "categories": ["utilities", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "assets/brand/icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "assets/brand/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/brand/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/brand/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/brand/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "files", "accept": ["*/*"] }]
    }
  },
  "shortcuts": [
    {
      "name": "Choose files",
      "short_name": "Open",
      "description": "Pick files to convert",
      "url": "./?action=open",
      "icons": [{ "src": "assets/brand/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Supported formats",
      "short_name": "Formats",
      "description": "Browse every format Convertible reads and writes",
      "url": "./?view=formats",
      "icons": [{ "src": "assets/brand/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Settings",
      "url": "./?view=settings",
      "icons": [{ "src": "assets/brand/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
