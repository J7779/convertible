[
  {"op": "log", "message": "a drag over any point shows the overlay; dropping anywhere adds the files"},
  {"op": "frames", "count": 2},
  {"op": "drag", "phase": "enter", "x": 40, "y": 700},
  {"op": "drag", "phase": "over", "x": 60, "y": 690},
  {"op": "wait", "ms": 300},
  {"op": "screenshot", "path": "overlay.bmp"},
  {"op": "dump", "path": "overlay.json"},
  {"op": "drag", "phase": "leave"},
  {"op": "frames", "count": 2},
  {"op": "dump", "path": "left.json"},
  {"op": "drag", "phase": "enter", "x": 1080, "y": 30},
  {"op": "frames", "count": 2},
  {"op": "open", "files": ["${IN}/one.txt", "${IN}/two.txt"], "x": 1080, "y": 30},
  {"op": "frames", "count": 3},
  {"op": "dump", "path": "dropped.json"},
  {"op": "drag", "phase": "enter", "x": 300, "y": 720},
  {"op": "frames", "count": 2},
  {"op": "expect", "path": "dropOverlay", "equals": true},
  {"op": "open", "files": ["${IN}/three.json", "${IN}/one.txt"], "x": 300, "y": 720},
  {"op": "frames", "count": 3},
  {"op": "dump", "path": "second.json"},
  {"op": "screenshot", "path": "second.bmp"}
]
