// Windows resources: icon, manifest (per-monitor DPI v2, common controls v6,
// UTF-8 code page) and version information.
#include <winver.h>

1 ICON "icon.ico"
1 24 "convertible.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Convertible contributors"
      VALUE "FileDescription", "Convertible - offline file converter"
      VALUE "FileVersion", "@CVD_VERSION@"
      VALUE "InternalName", "Convertible"
      VALUE "LegalCopyright", "Convertible contributors. MIT licence."
      VALUE "OriginalFilename", "Convertible.exe"
      VALUE "ProductName", "Convertible"
      VALUE "ProductVersion", "@CVD_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
