[
  {"op": "log", "message": "per-file progress, stepped through the progress gate so every report is seen"},
  {"op": "open", "files": ["${IN}/big.bin"]},
  {"op": "setTarget", "index": 0, "target": "base64"},
  {"op": "frames", "count": 30},
  {"op": "gate", "mode": "hold"},
  {"op": "click", "label": "Convert", "exact": true, "last": true},
  {"op": "gateWait", "parked": 1},
  {"op": "frames", "count": 2},
  {"op": "dump", "path": "c-start.json"},
  {"op": "stepProgress", "index": 0, "steps": 1},
  {"op": "frames", "count": 30},
  {"op": "dump", "path": "c-mid.json"},
  {"op": "screenshot", "path": "c-mid.bmp"},
  {"op": "stepProgress", "index": 0, "append": true, "maxSteps": 100000},
  {"op": "gate", "mode": "open"},
  {"op": "waitIdle"},
  {"op": "frames", "count": 40},
  {"op": "dump", "path": "c-done.json"},
  {"op": "screenshot", "path": "c-done.bmp"},
  {"op": "saveAll", "dir": "saved", "expect": 1}
]
