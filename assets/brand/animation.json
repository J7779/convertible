  "progress": {
    "description": "Determinate progress derived from the mark. p is 0..1.",
    "layers": [
      {
        "id": "track",
        "sameAs": "spinner.track"
      },
      {
        "id": "runner",
        "type": "stroke",
        "geometry": "centerline",
        "stroke": "flux",
        "trimStart": 0,
        "trimEnd": "p"
      },
      {
        "id": "seed",
        "type": "shape",
        "geometry": "seed",
        "fill": "flux",
        "scale": "p > 0 ? 1 : 0"
      }
    ],
    "transition": "Animate changes of p over 220 ms with easing standard. At p = 1 the indicator is the logo; optionally play the rippleSquare track of the intro once (480 ms) as a completion cue."
  },
  "reducedMotion": {
    "intro": "Skip the animation and show the static logo. A plain opacity fade from 0 to 1 over 140 ms is acceptable.",
    "spinner": "No drawing. Show runner and seed fully drawn and pulse the opacity of both between 1 and 0.45 with easing inOut, 800 ms each way."
  },
  "implementation": {
    "swiftui": "Build the centerline as a Path and stroke it with StrokeStyle(lineWidth: 200, lineCap: .butt, lineJoin: .miter) after .trim(from:to:). Fill with LinearGradient(stops:) using startPoint/endPoint at y 360/1024 and 664/1024 of the mark frame. Drive tracks with keyframeAnimator or a TimelineView and UnitCurve.bezier / Animation.timingCurve.",
    "compose": "Use PathMeasure.getSegment(start * length, end * length, dst) for the trim and drawPath with Stroke(width, cap = StrokeCap.Butt, join = StrokeJoin.Miter). Brush.verticalGradient(0f to iris, 0.5f to orchid, 1f to coral, startY = 360, endY = 664) in canvas units. Use keyframes { } with CubicBezierEasing per segment.",
    "imgui": "Flatten the centerline with PathLineTo / PathArcTo (centre 512,512 radius 252 from 270deg to 180deg, at least 24 segments), cut the polyline at the trim fractions and draw it as quads with per-vertex colours sampled from the gradient by vertex y (AddConvexPolyFilled or PrimReserve). Draw the seed with AddCircleFilled. Evaluate cubic-bezier easings numerically.",
    "css": "See logo-animated.svg and spinner.svg: pathLength=\"1000\", stroke-dasharray and stroke-dashoffset for the trim, one @keyframes rule per track group with animation-timing-function on each keyframe."
  }
