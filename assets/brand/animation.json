  "canvas": {
    "width": 1024,
    "height": 1024,
    "origin": "top-left",
    "yAxis": "down",
    "units": "canvas units; scale uniformly to the target size",
    "background": "transparent"
  },
  "conventions": {
    "time": "Milliseconds from the start of the animation (or of the loop iteration).",
    "keyframes": "Each track lists keyframes in time order. Before the first keyframe the property holds the first keyframe value; after the last it holds the last value. Properties without a track stay at the layer base value.",
    "easing": "The easing named on a keyframe shapes the interpolation from that keyframe to the next one. Names resolve through the easings table to cubic-bezier control points [x1, y1, x2, y2] (CSS convention). A keyframe without an easing is followed by a hold or is the last one.",
    "trim": "trimStart and trimEnd are fractions (0..1) of the centerline length measured from its first point. Only the part between them is stroked.",
    "transforms": "scale and rotationDeg apply around the layer pivot in canvas units. Positive rotation is clockwise on screen. A group transform applies to all of its children.",
    "order": "Layers are listed back to front."
  },
  "easings": {
    "standard": [
      0.2,
      0,
      0,
      1
    ],
    "decelerate": [
      0.16,
      1,
      0.3,
      1
    ],
    "accelerate": [
      0.7,
      0,
      0.84,
      0
    ],
    "inOut": [
      0.65,
      0,
      0.35,
      1
    ],
