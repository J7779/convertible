# Line endings and diff handling.
#
# Sources are normalised to LF in the repository and checked out with the platform's
# native endings, except where a tool needs a fixed ending (below). Test data and every
# binary asset are bytes: git must never rewrite them, on any platform, because the tests
# compare them byte for byte. Later, more specific rules override earlier ones.

* text=auto

# --- Fixed line endings -------------------------------------------------------------
*.sh            text eol=lf
gradlew         text eol=lf
tools/*         text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
*.pbxproj       text eol=lf

# --- Test data: bytes, never converted (also covered by core/tests/data/.gitattributes)
core/tests/data/**              -text
apps/**/fixtures/**             -text
apps/**/tests/data/**           -text

