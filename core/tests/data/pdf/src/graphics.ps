%!PS-Adobe-3.0
%%BoundingBox: 0 0 300 300
%%Pages: 1
%%EndComments
<< /PageSize [300 300] >> setpagedevice
% background frame
0.95 setgray 0 0 300 300 rectfill
% filled red rectangle
1 0 0 setrgbcolor 20 220 80 60 rectfill
% even-odd star in blue
0 0 1 setrgbcolor
newpath 190 280 moveto 215 205 lineto 150 255 lineto 230 255 lineto 165 205 lineto closepath eofill
% thick strokes: caps and joins
0 setgray 12 setlinewidth
0 setlinecap 0 setlinejoin newpath 20 180 moveto 70 180 lineto 70 140 lineto stroke
1 setlinecap 1 setlinejoin newpath 100 180 moveto 150 180 lineto 150 140 lineto stroke
2 setlinecap 2 setlinejoin newpath 180 180 moveto 230 180 lineto 230 140 lineto stroke
% dashed line
0 0.5 0 setrgbcolor 3 setlinewidth [10 5] 0 setdash
newpath 20 120 moveto 280 120 lineto stroke [] 0 setdash
% clipped circle
gsave newpath 20 20 100 80 rectclip
1 0.6 0 setrgbcolor newpath 70 60 60 0 360 arc fill grestore
% axial shading
gsave newpath 140 20 140 80 rectclip
<< /ShadingType 2 /ColorSpace /DeviceRGB /Coords [140 0 280 0]
   /Function << /FunctionType 2 /Domain [0 1] /C0 [1 1 0] /C1 [0 0.4 1] /N 1 >> >> shfill grestore
% CMYK fill
0 1 1 0 setcmykcolor 250 220 30 30 rectfill
showpage
%%EOF
