; GIMP 2.10 Script-Fu: build small layered documents and save them as XCF,
; with GIMP's own flattened rendering of each as a PNG reference.
; Run from the directory holding bg.png and fade.png:
;   gimp-console -i -b '(load "make_xcf.scm")' -b '(gimp-quit 0)'

(define (export-reference img path)
  (let* ((dup (car (gimp-image-duplicate img)))
         (merged (car (gimp-image-merge-visible-layers dup CLIP-TO-IMAGE))))
    (if (and (not (= (car (gimp-image-base-type dup)) INDEXED))
             (not (= (car (gimp-image-get-precision dup)) PRECISION-U8-GAMMA)))
        (gimp-image-convert-precision dup PRECISION-U8-GAMMA))
    (file-png-save2 RUN-NONINTERACTIVE dup merged path path 0 9 0 0 0 0 0 0 0)
    (gimp-image-delete dup)))

(define (save-xcf img path)
  (gimp-xcf-save 0 img (car (gimp-image-get-active-drawable img)) path path))

(define (solid-layer img name w h r g b opacity mode)
  (let ((layer (car (gimp-layer-new img w h RGBA-IMAGE name opacity mode))))
    (gimp-context-set-foreground (list r g b))
    (gimp-drawable-fill layer FILL-FOREGROUND)
    layer))

(define (build)
  (let* ((img (car (gimp-file-load RUN-NONINTERACTIVE "bg.png" "bg.png")))
         (bg (car (gimp-image-get-active-layer img)))
         (box (solid-layer img "box" 24 16 255 255 255 60 LAYER-MODE-NORMAL))
         (legacy (solid-layer img "legacy" 20 20 0 0 160 50 LAYER-MODE-NORMAL-LEGACY))
         (hidden (solid-layer img "hidden" 64 48 0 0 0 100 LAYER-MODE-NORMAL))
         (fade (car (gimp-file-load-layer RUN-NONINTERACTIVE img "fade.png")))
         (group (car (gimp-layer-group-new img)))
         (child (solid-layer img "child" 10 10 255 0 255 100 LAYER-MODE-NORMAL)))
    (gimp-image-set-resolution img 96 96)
    (gimp-image-insert-layer img box 0 -1)
    (gimp-layer-set-offsets box 8 6)
    (gimp-image-insert-layer img legacy 0 -1)
    (gimp-layer-set-offsets legacy 40 2)
    (gimp-image-insert-layer img fade 0 -1)
    (gimp-layer-set-offsets fade 30 14)
    ; Move the fade layer's alpha into a layer mask.
    (gimp-layer-add-mask fade (car (gimp-layer-create-mask fade ADD-MASK-ALPHA-TRANSFER)))
    (gimp-image-insert-layer img hidden 0 -1)
    (gimp-item-set-visible hidden FALSE)
    (gimp-image-insert-layer img group 0 -1)
    (gimp-layer-set-opacity group 80)
    (gimp-image-insert-layer img child group 0)
    (gimp-layer-set-offsets child -4 36)
    img))

(define (variant img precision name)
  (let ((dup (car (gimp-image-duplicate img))))
    (if (not (= precision 0)) (gimp-image-convert-precision dup precision))
    (save-xcf dup (string-append name ".xcf"))
    (export-reference dup (string-append name ".png"))
    (gimp-image-delete dup)))

(let ((img (build)))
  (variant img 0 "rgb8")
  (variant img PRECISION-U8-LINEAR "u8_linear")
  (variant img PRECISION-U16-GAMMA "u16_gamma")
  (variant img PRECISION-U32-LINEAR "u32_linear")
  (variant img PRECISION-HALF-LINEAR "half_linear")
  (variant img PRECISION-FLOAT-GAMMA "float_gamma")
  (variant img PRECISION-DOUBLE-LINEAR "double_linear")
  (let ((grey (car (gimp-image-duplicate img))))
    (gimp-image-convert-grayscale grey)
    (save-xcf grey "grey8.xcf")
    (export-reference grey "grey8.png"))
  (let* ((indexed (car (gimp-file-load RUN-NONINTERACTIVE "bg.png" "bg.png")))
         (top (car (gimp-file-load-layer RUN-NONINTERACTIVE indexed "fade.png"))))
    (gimp-image-insert-layer indexed top 0 -1)
    (gimp-layer-set-offsets top 20 8)
    (gimp-image-convert-indexed indexed CONVERT-DITHER-NONE CONVERT-PALETTE-GENERATE 24 FALSE FALSE "")
    (save-xcf indexed "indexed.xcf")
    (export-reference indexed "indexed.png")))
