[
  {"op": "log", "message": "end-to-end: open, pick targets, convert, save, screenshot"},
  {"op": "skipIntro"},
  {"op": "frames", "count": 2},
  {"op": "expect", "path": "screen", "equals": "home"},
  {"op": "screenshot", "path": "01-empty.png"},
  {"op": "open", "files": ["FIXTURES/hello.txt", "FIXTURES/fox.txt", "FIXTURES/unicode.txt"]},
  {"op": "frames", "count": 3},
  {"op": "expect", "path": "items.0.source", "equals": "txt"},
  {"op": "expect", "path": "items.2.name", "equals": "unicode.txt"},
  {"op": "setTarget", "index": 0, "target": "base64"},
  {"op": "setTarget", "index": 1, "target": "hex"},
  {"op": "setTarget", "index": 2, "target": "txt"},
  {"op": "setOption", "index": 2, "key": "encoding", "value": "utf-16le"},
  {"op": "setOption", "index": 2, "key": "line_endings", "value": "lf"},
  {"op": "frames", "count": 2},
  {"op": "click", "label": "Convert all"},
  {"op": "frames", "count": 2},
  {"op": "waitIdle"},
  {"op": "frames", "count": 40},
  {"op": "expect", "path": "items.0.status", "equals": "done"},
  {"op": "expect", "path": "items.1.status", "equals": "done"},
  {"op": "expect", "path": "items.2.status", "equals": "done"},
  {"op": "saveAll", "dir": "saved", "expect": 3},
  {"op": "expect", "file": "saved/hello.b64", "content": "SGVsbG8sIHdvcmxkIQo=\n"},
  {"op": "expect", "file": "saved/fox.hex", "content": "54686520717569636b2062726f776e20666f78206a756d7073206f76657220746865206c617a7920646f67"},
  {"op": "screenshot", "path": "02-done.png"},
  {"op": "dump", "path": "state.json"}
]
