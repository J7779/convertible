[
  {"op": "log", "message": "cancel one conversion, then cancel all, then convert again"},
  {"op": "open", "files": ["${IN}/big1.bin", "${IN}/big2.bin"]},
  {"op": "setTarget", "index": 0, "target": "base64"},
  {"op": "setTarget", "index": 1, "target": "hex"},
  {"op": "frames", "count": 30},
  {"op": "gate", "mode": "hold"},
  {"op": "click", "label": "Convert all", "exact": true},
  {"op": "gateWait", "parked": 2},
  {"op": "frames", "count": 5},
  {"op": "dump", "path": "k-busy.json"},
  {"op": "screenshot", "path": "k-busy.bmp"},
  {"op": "click", "label": "Cancel this conversion", "nth": 0},
  {"op": "waitFor", "path": "items.0.status", "equals": "cancelled"},
  {"op": "frames", "count": 5},
  {"op": "dump", "path": "k-one.json"},
  {"op": "click", "label": "Cancel all", "exact": true},
  {"op": "waitFor", "path": "items.1.status", "equals": "cancelled"},
  {"op": "frames", "count": 20},
  {"op": "dump", "path": "k-all.json"},
  {"op": "screenshot", "path": "k-all.bmp"},
  {"op": "gate", "mode": "open"},
  {"op": "click", "label": "Convert again", "exact": true, "nth": 0},
  {"op": "frames", "count": 2},
  {"op": "click", "label": "Convert again", "exact": true, "nth": 0},
  {"op": "frames", "count": 3},
  {"op": "dump", "path": "k-ready.json"},
  {"op": "click", "label": "Convert all", "exact": true},
  {"op": "waitIdle"},
  {"op": "frames", "count": 5},
  {"op": "saveAll", "dir": "saved", "expect": 2},
  {"op": "dump", "path": "k-done.json"}
]
